# Application Environment
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=connected

# Security & Authentication
JWT_SECRET_KEY=change-this-to-a-super-secret-random-key-in-production-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Telegram Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_token_here
TELEGRAM_BOT_USERNAME=connectED_bot

# External Services (Optional proxies)
AI_SERVICE_URL=
GRAPH_SERVICE_URL=
